Include the fixed-width integer declarations used by the tgcalls headers.

With GCC 16, Instance.cpp and EncryptedConnection.cpp fail because uint8_t,
uint16_t and uint64_t are not declared through the existing standard headers.
Both headers use these types directly and need their own cstdint include.

Applies to the tgcalls commit used by AyuGram v6.3.10:
https://github.com/TelegramMessenger/tgcalls/tree/24876ebca7da10f92dc972225734337f9e793054

--- a/Telegram/ThirdParty/tgcalls/tgcalls/DirectConnectionChannel.h
+++ b/Telegram/ThirdParty/tgcalls/tgcalls/DirectConnectionChannel.h
@@ -1,6 +1,7 @@
 #ifndef TGCALLS_DIRECT_CONNECTION_CHANNEL_H
 #define TGCALLS_DIRECT_CONNECTION_CHANNEL_H
 
+#include <cstdint>
 #include <functional>
 #include <memory>
 #include <vector>
--- a/Telegram/ThirdParty/tgcalls/tgcalls/Instance.h
+++ b/Telegram/ThirdParty/tgcalls/tgcalls/Instance.h
@@ -1,6 +1,7 @@
 #ifndef TGCALLS_INSTANCE_H
 #define TGCALLS_INSTANCE_H
 
+#include <cstdint>
 #include <functional>
 #include <vector>
 #include <string>
