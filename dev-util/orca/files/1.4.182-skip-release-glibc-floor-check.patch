From: JC Zhang <chengrui0727@gmail.com>
Subject: [PATCH] Skip the binary release glibc floor check

Gentoo builds native modules for the target system instead of producing an
upstream binary release compatible with Ubuntu 20.04.  The release-only gate
therefore rejects valid locally built modules when the system glibc is newer.

diff --git a/config/electron-builder.config.cjs b/config/electron-builder.config.cjs
--- a/config/electron-builder.config.cjs
+++ b/config/electron-builder.config.cjs
@@ -11,7 +11,6 @@ const {
   prunePackagedRuntimeNodeModules,
   verifyPackagedMainRuntimeDeps
 } = require('./packaged-runtime-node-modules.cjs')
-const { verifyLinuxGlibcFloor } = require('./scripts/verify-linux-glibc-floor.cjs')
 const { writeMacBuildCompatibility } = require('./scripts/mac-build-compatibility.cjs')
 const { verifyPackagedPluginResources } = require('./scripts/verify-packaged-plugin-resources.cjs')
 const { verifySkillsCliRuntime } = require('./scripts/verify-skills-cli-runtime.cjs')
@@ -183,12 +182,6 @@ module.exports = {
     'node_modules/sherpa-onnx*/**'
   ],
   afterPack: async (context) => {
-    // Why: a Linux runner-image glibc bump silently shipped a node-pty pty.node
-    // requiring GLIBC_2.34, crashing the app on startup on Ubuntu 20.04 (#9902).
-    // Fail packaging if any bundled native binary exceeds the supported floor.
-    if (context.electronPlatformName === 'linux') {
-      verifyLinuxGlibcFloor(context.appOutDir)
-    }
     const resourcesDir =
       context.electronPlatformName === 'darwin'
         ? join(
